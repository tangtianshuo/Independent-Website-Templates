{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "compatibility", "models", "pages", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/identifier" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "$ref": "#/definitions/nonempty" },
    "description": { "type": "string" },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["cmsSchema", "releaseSchema"],
      "properties": { "cmsSchema": { "const": 1 }, "releaseSchema": { "const": 1 } }
    },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/model" } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/page" } },
    "assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } }
  },
  "definitions": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "type", "required", "array"],
      "properties": {
        "key": { "$ref": "#/definitions/key" }, "label": { "$ref": "#/definitions/nonempty" },
        "type": { "enum": ["STRING", "NUMBER", "BOOLEAN", "DATE", "ENUMERATION", "MEDIA", "GROUP_POINTER", "ENTRY_POINTER", "WIDGET", "RICH_TEXT"] },
        "required": { "type": "boolean" }, "array": { "type": "boolean" },
        "referenceModel": { "$ref": "#/definitions/key" }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "description", "singleEntry", "fields"],
      "properties": {
        "key": { "$ref": "#/definitions/key" }, "label": { "$ref": "#/definitions/nonempty" },
        "description": { "type": "string" }, "singleEntry": { "type": "boolean" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/field" } }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "title", "path", "modelKey", "layout"],
      "properties": {
        "key": { "$ref": "#/definitions/key" }, "title": { "$ref": "#/definitions/nonempty" },
        "path": { "type": "string", "pattern": "^/(?:[a-z0-9-]+|:[a-z][a-z0-9]*)(?:/(?:[a-z0-9-]+|:[a-z][a-z0-9]*))*$|^/$" },
        "modelKey": { "$ref": "#/definitions/key" }, "layout": { "$ref": "#/definitions/nonempty" }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "checksum", "mimeType"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*/[a-zA-Z0-9_-]+\\.(?:png|jpe?g|webp|gif|avif)$" },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/avif"] }
      }
    }
  }
}
